# Local Docker Compose ports (published on 127.0.0.1 only).
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_ADMIN_PORT=8001

# PostgreSQL. Compose supplies internal addresses; uv processes can override
# POSTGRES_HOST=127.0.0.1, POSTGRES_PORT and REDIS_URL on the command line.
POSTGRES_DB=kufar
POSTGRES_USER=kufar
POSTGRES_PASSWORD=kufar
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional override (use if you prefer a single URL instead of POSTGRES_* vars)
# DATABASE_URL=postgresql+asyncpg://kufar:kufar@db:5432/kufar

# Parser scheduler
# Incremental collection and the independent safe full reconciliation.
NEW_LISTINGS_INTERVAL_SECONDS=60
NEW_LISTINGS_MAX_PAGES=5
NEW_LISTINGS_KNOWN_PAGE_OVERLAP=2
FULL_RECONCILIATION_INTERVAL_SECONDS=86400
# 0 = follow all source cursors; a positive cap makes an unfinished full scan fail.
FULL_RECONCILIATION_MAX_PAGES=0
# Формат: name:rgn:ar через запятую
# rgn/ar коды берутся из параметров Kufar API
CITIES=grodno:3:9

# Admin panel — Telegram Login Widget auth (separate bot registered in BotFather)
ADMIN_TELEGRAM_AUTH_ENABLED=false
AUTH_BOT_TOKEN=<telegram-bot-token-for-admin-login>
SESSION_SECRET_KEY=change-me-in-production
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Use a dedicated local Telegram bot to avoid concurrent polling with production.
LITE_BOT_TOKEN=<telegram-bot-token-for-user-bot>
# Deprecated fallback; remove after every deployment has migrated to LITE_BOT_TOKEN.
# FINDER_BOT_TOKEN=<telegram-bot-token-for-user-bot>
REDIS_URL=redis://redis:6379/1
NOTIFICATION_SCAN_INTERVAL=10

# Display source timestamps in this timezone; storage is always UTC.
DISPLAY_TIMEZONE=Europe/Minsk

# Background availability check for cities with saved apartments.
AVAILABILITY_CHECK_INTERVAL_SECONDS=300
