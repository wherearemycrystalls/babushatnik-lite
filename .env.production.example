# Copy to .env.production locally, or a protected .env on the production host.
# This file is not uploaded by CI. Replace every placeholder before deployment.
# APP_IMAGE=ghcr.io/<owner>/babushatnik-lite@sha256:<64-hex-digest>
# For an existing deployment, set COMPOSE_PROJECT_NAME to its previous project
# name before starting services, so its existing named volumes are reused.
PROD_ADMIN_PORT=8081
POSTGRES_DB=kufar
POSTGRES_USER=kufar
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CITIES=grodno:3:9
NEW_LISTINGS_INTERVAL_SECONDS=60
NEW_LISTINGS_MAX_PAGES=5
NEW_LISTINGS_KNOWN_PAGE_OVERLAP=2
FULL_RECONCILIATION_INTERVAL_SECONDS=86400
# 0 = follow all source cursors; a positive cap makes an unfinished full scan fail.
FULL_RECONCILIATION_MAX_PAGES=0
NOTIFICATION_SCAN_INTERVAL=10

AUTH_BOT_TOKEN=replace-with-admin-telegram-bot-token
ADMIN_TELEGRAM_AUTH_ENABLED=true
LITE_BOT_TOKEN=replace-with-user-telegram-bot-token
SESSION_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_TELEGRAM_IDS=123456789
REDIS_URL=redis://redis:6379/1

# Backup retention is interpreted by scripts/backup-db.sh.
BACKUP_RETENTION_DAYS=14

# Display source timestamps in this timezone; storage is always UTC.
DISPLAY_TIMEZONE=Europe/Minsk

# Background availability check for cities with saved apartments.
AVAILABILITY_CHECK_INTERVAL_SECONDS=300
